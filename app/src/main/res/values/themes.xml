<resources>
    <style name="Theme.ProxyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Violet seed, M3-dark tonal roles -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorPrimaryVariant">@color/violet_900</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="colorSecondaryContainer">@color/violet_800</item>
        <item name="colorTertiary">@color/brand_tertiary</item>
        <!-- Plum surfaces: elevation reads through lightness, not shadow -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <!-- Desaturated error that lives with violet -->
        <item name="colorError">@color/status_error_soft</item>
        <item name="colorOnError">@color/status_on_error</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <!-- Outlined inputs pick up the violet system automatically -->
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Theme.ProxyApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Section headers: quiet lavender, letterspaced, never competing -->
    <style name="Text.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/title_violet</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Muted hint lines under headers -->
    <style name="Text.Hint" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/hint_text</item>
    </style>

    <!-- Monospace script blocks -->
    <style name="Text.ScriptBlock" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
